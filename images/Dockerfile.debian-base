# [Choice] Debian version: trixie, bookworm, latest...
ARG VARIANT="latest"
FROM bitnami/minideb:${VARIANT}

# Set locale so Unicode characters render correctly in locale-aware tools (e.g. tmux).
ENV LANG=C.UTF-8

# Mainly done to upgrade packages to avoid security issues
RUN apt-get update && export DEBIAN_FRONTEND=noninteractive \
    && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

# [Optional] Uncomment this section to install additional OS packages.
RUN apt-get update && export DEBIAN_FRONTEND=noninteractive \
    #&& apt-get -y install --no-install-recommends <your-package-list-here>
    && install_packages curl git fish rsync bubblewrap tar gzip \
    ca-certificates && update-ca-certificates

#SHELL ["/usr/bin/fish"]
